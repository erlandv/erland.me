---
/**
 * HeroImage Component
 *
 * Optimized hero image component with responsive sizing and multiple densities.
 * Supports both remote R2 URLs (string) and local ImageMetadata.
 *
 * - Remote URL: renders a plain <img> tag (Cloudflare CDN serves the image)
 * - Local ImageMetadata: uses Astro's <Image> with full optimization pipeline
 *
 * @component
 * @example
 * <HeroImage
 *   image="https://img.erland.me/blog/slug/hero.png"
 *   alt="Hero image description"
 * />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isRemoteHero, type HeroSource } from '@lib/content/images';
import '@/styles/components/hero.css';

interface Props {
  image: HeroSource;
  alt: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
  widths?: number[];
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  image,
  alt,
  loading = 'eager',
  sizes = '(max-width: 640px) min(60vw, 320px), min(45vw, 320px)',
  widths = [180, 220, 270, 320, 480, 640],
  fetchpriority = 'high',
} = Astro.props as Props;
---

{
  isRemoteHero(image) ? (
    // Remote R2 URL — plain img tag, Cloudflare CDN handles delivery
    <img
      src={image}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      class='hero-image'
      decoding='async'
    />
  ) : (
    // Local ImageMetadata — Astro optimizes with responsive srcset
    <Image
      src={image as ImageMetadata}
      alt={alt}
      loading={loading}
      widths={widths}
      sizes={sizes}
      fetchpriority={fetchpriority}
      class='hero-image'
    />
  )
}
