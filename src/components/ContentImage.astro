---
/**
 * ContentImage Component
 *
 * Smart image component used as override for img tags in Markdown content.
 * After R2 migration, all content images are absolute URLs (https://img.erland.me/...).
 * This component simply renders a standard img tag with lazy loading and prose styling.
 *
 * For external URLs (R2), Cloudflare CDN handles delivery — no local optimization needed.
 *
 * @component
 * @example
 * In markdown: ![Alt text](https://img.erland.me/blog/slug/images/photo.jpg)
 * Renders as: <img src="https://img.erland.me/..." alt="Alt text" loading="lazy" />
 */
import { getContentImageConfig } from '@lib/content/images';

interface Props {
  src: string;
  alt?: string;
  width?: number | string;
  height?: number | string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { src, alt = '', loading = 'lazy', class: cls } = Astro.props as Props;

// getContentImageConfig kept for potential future use with local images
const {} = getContentImageConfig();
---

<img src={src} alt={alt} loading={loading} decoding='async' class={cls} />
